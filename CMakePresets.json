{
  "version": 2,
  "configurePresets": [
    {"name":"release","generator":"Ninja","binaryDir":"${sourceDir}/build/release","cacheVariables":{"CMAKE_BUILD_TYPE":"Release"}},
    {"name":"debug","inherits":"release","binaryDir":"${sourceDir}/build/debug","cacheVariables":{"CMAKE_BUILD_TYPE":"Debug"}},
    {"name":"sanitize","inherits":"debug","binaryDir":"${sourceDir}/build/sanitize","cacheVariables":{"BLITZ_SANITIZE":"ON"}},
    {"name":"research","inherits":"release","binaryDir":"${sourceDir}/build/research","cacheVariables":{"BLITZ_RESEARCH":"ON"}}
  ],
  "buildPresets":[
    {"name":"release","configurePreset":"release","jobs":4},
    {"name":"sanitize","configurePreset":"sanitize","jobs":4},
    {"name":"research","configurePreset":"research","jobs":4}
  ],
  "testPresets":[
    {"name":"release","configurePreset":"release","output":{"outputOnFailure":true}},
    {"name":"sanitize","configurePreset":"sanitize","output":{"outputOnFailure":true}}
  ]
}
